<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="GameDir.props" Condition="Exists('GameDir.props')" />
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <AssemblyName>SkilledCartographer</AssemblyName>
    <RootNamespace>Surveying</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <DebugType>none</DebugType>
    <CheckEolTargetFramework>false</CheckEolTargetFramework>
    <!-- Where The Long Dark is installed. Override with -p:GameDir=... or a local GameDir.props. -->
    <GameDir Condition="'$(GameDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\TheLongDark</GameDir>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="$(GameDir)/MelonLoader/net6/MelonLoader.dll" Private="false" />
    <Reference Include="$(GameDir)/MelonLoader/net6/0Harmony.dll" Private="false" />
    <Reference Include="$(GameDir)/MelonLoader/net6/Il2CppInterop.Runtime.dll" Private="false" />
    <Reference Include="$(GameDir)/MelonLoader/net6/Il2CppInterop.Common.dll" Private="false" />
    <Reference Include="$(GameDir)/MelonLoader/Il2CppAssemblies/*.dll" Private="false" />
    <Reference Include="$(GameDir)/Mods/ModData.dll" Private="false" />
    <Reference Include="$(GameDir)/Mods/ModSettings.dll" Private="false" />
  </ItemGroup>
</Project>
